# Everything the ngp build pins. Change a value here, then rerun `pnpm toolchain`.

# Angular commit ngp is built from. 9f2e1aa is the commit the 22.3.0-rc.0 release was cut at.
ANGULAR_SHA=9f2e1aa01e7889b333347ed9094115b2f58f07fd

# The npm release built from ANGULAR_SHA. ngp's backend is compiled against the installed
# @angular/compiler and imports names this release was the first to export, so every exact
# @angular/* version in this repo must equal this one. The plugin's peer range is wider:
# site/content/compatibility.md says what it accepts and how that was checked.
ANGULAR_NPM_VERSION=22.3.0-rc.0

# Rust toolchain for both engines, installed locally by setup-rust.sh.
RUST_TOOLCHAIN=1.96.0

# Must equal the wasm-bindgen crate version in Angular's Cargo.lock (Cargo.toml pins =0.2.121).
WASM_BINDGEN_VERSION=0.2.121
